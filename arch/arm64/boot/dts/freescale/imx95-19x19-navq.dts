 * Copyright 2023 NXP
 */

/dts-v1/;

#include <dt-bindings/phy/phy-imx8-pcie.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/usb/pd.h>
#include "imx95.dtsi"

#define FALLING_EDGE		BIT(0)
#define RISING_EDGE		BIT(1)

#define BRD_SM_CTRL_SD3_WAKE		0x8000	/*!< PCAL6408A-0 */
#define BRD_SM_CTRL_PCIE1_WAKE		0x8001	/*!< PCAL6408A-4 */
#define BRD_SM_CTRL_BT_WAKE		0x8002	/*!< PCAL6408A-5 */
#define BRD_SM_CTRL_PCIE2_WAKE		0x8003	/*!< PCAL6408A-6 */
#define BRD_SM_CTRL_BUTTON		0x8004	/*!< PCAL6408A-7 */

/ {
	model = "NXP i.MX95 19X19 board";
	compatible = "fsl,imx95-19x19-evk", "fsl,imx95";

	aliases {
		ethernet0 = &enetc_port0;
		ethernet1 = &enetc_port2;
	};

	chosen {
		stdout-path = &lpuart1;
		#address-cells = <2>;
		#size-cells = <2>;
		/* will be updated by U-boot when booting Xen */
		module@0 {
			bootargs = "earlycon=xen console=hvc0 loglevel=8 root=/dev/mmcblk1p2 rw rootwait";
			compatible = "xen,linux-zimage", "xen,multiboot-module";
			reg = <0x00000000 0x9e000000 0x00000000 0x2000000>;
		};
	};

	fan0: pwm-fan {
		compatible = "pwm-fan";
		cooling-min-state = <0>;
		cooling-max-state = <3>;
		#cooling-cells = <2>;
		pwms = <&tpm6 2 4000000 PWM_POLARITY_INVERTED>;
		cooling-levels = <64 128 192 255>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0 0x80000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux_cma: linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0 0x3c000000>;
			alloc-ranges = <0 0x80000000 0 0x7F000000>;
			linux,cma-default;
		};

		vpu_boot: vpu_boot@a0000000 {
			reg = <0 0xa0000000 0 0x100000>;
			no-map;
		};

		vdev0vring0: vdev0vring0@88000000 {
			reg = <0 0x88000000 0 0x8000>;
			no-map;
		};

		vdev0vring1: vdev0vring1@88008000 {
			reg = <0 0x88008000 0 0x8000>;
			no-map;
		};

		vdev1vring0: vdev1vring0@88010000 {
			reg = <0 0x88010000 0 0x8000>;
			no-map;
		};

		vdev1vring1: vdev1vring1@88018000 {
			reg = <0 0x88018000 0 0x8000>;
			no-map;
		};

		rsc_table: rsc-table@88220000 {
			reg = <0 0x88220000 0 0x1000>;
			no-map;
		};

		vdevbuffer: vdevbuffer@88020000 {
			compatible = "shared-dma-pool";
			reg = <0 0x88020000 0 0x100000>;
			no-map;
		};

		m7text: m7text@90000000 {
			reg = <0 0x90000000 0 0x400000>;
			no-map;
		};
	};

	reg_1p8v: regulator-1p8v {
		compatible = "regulator-fixed";
		regulator-max-microvolt = <1800000>;
		regulator-min-microvolt = <1800000>;
		regulator-name = "+V1.8_SW";
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "+V3.3_SW";
	};

	reg_can1_stby: regulator-can1-stby {
		compatible = "regulator-fixed";
		regulator-name = "can1-stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c3_ioexp22 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&reg_can1_en>;
	};

	reg_can1_en: regulator-can1-en {
		compatible = "regulator-fixed";
		regulator-name = "can1-en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c3_ioexp22 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_can2_stby: regulator-can2-stby {
		compatible = "regulator-fixed";
		regulator-name = "can2-stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c3_ioexp22 5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&reg_can2_en>;
	};

	reg_can2_en: regulator-can2-en {
		compatible = "regulator-fixed";
		regulator-name = "can2-en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c3_ioexp22 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_can3_stby: regulator-can3-stby {
		compatible = "regulator-fixed";
		regulator-name = "can3-stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c3_ioexp22 8 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&reg_can3_en>;
	};

	reg_can3_en: regulator-can3-en {
		compatible = "regulator-fixed";
		regulator-name = "can3-en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c3_ioexp22 7 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_can5_stby: regulator-can5-stby {
		compatible = "regulator-fixed";
		regulator-name = "can5-stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c3_ioexp22 11 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&reg_can5_en>;
	};

	reg_can5_en: regulator-can5-en {
		compatible = "regulator-fixed";
		regulator-name = "can5-en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c3_ioexp22 10 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_usdhc2_vmmc: regulator-usdhc2 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
		regulator-name = "VDD_SD2_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio3 7 GPIO_ACTIVE_HIGH>;
		off-on-delay-us = <12000>;
		enable-active-high;
	};

	reg_usdhc3_vmmc: regulator-usdhc3 {
		compatible = "regulator-fixed";
		regulator-name = "vmmcusdhc3_fixed";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	usdhc3_pwrseq: usdhc3-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&i2c2_ioexp21 22 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <200>;
	};

	reg_pcie0: regulator-pcie0 {
		compatible = "regulator-fixed";
		regulator-name = "SLOT_PWREN_SDD";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c3_ioexp22 13 GPIO_ACTIVE_LOW>;
		enable-active-low;
		regulator-always-on;
	};

	reg_vref_1v8: regulator-adc-vref {
		compatible = "regulator-fixed";
		regulator-name = "vref_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	reg_pcie1: regulator-pcie1 {
		compatible = "regulator-fixed";
		regulator-name = "SLOT_PWREN_5G";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c3_ioexp22 14 GPIO_ACTIVE_LOW>;
		enable-active-low;
		regulator-always-on;
	};

	reg_serdes_stby: regulator-mac-stby {
		compatible = "regulator-fixed";
		regulator-name = "mac-stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c2_ioexp21 18 GPIO_ACTIVE_LOW>;
	};

	reg_serdes_en: regulator-mac-en {
		compatible = "regulator-fixed";
		regulator-name = "mac-en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&reg_serdes_stby>;
		gpio = <&i2c2_ioexp21 17 GPIO_ACTIVE_LOW>;
	};

	cm7: imx95-cm7 {
		compatible = "fsl,imx95-cm7";
		mbox-names = "tx", "rx", "rxdb";
		mboxes = <&mu7 0 1
			  &mu7 1 1
			  &mu7 3 1>;
		memory-region = <&vdevbuffer>, <&vdev0vring0>, <&vdev0vring1>,
				<&vdev1vring0>, <&vdev1vring1>, <&rsc_table>;
		fsl,startup-delay-ms = <50>;
		status = "okay";
	};
};

&adc1 {
	vref-supply = <&reg_vref_1v8>;
	status = "disabled";
};

&displaymix_irqsteer {
	status = "disabled";
};

&dpu {
	status = "disabled";
};

/* The M7 also uses the AON.EDMA and sharing isn't supported yet in Linux */
&edma1 {
	status = "disabled";
};

&tpm3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_tpm3>;
	status = "disabled";
};

&tpm6 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_tpm6>;
	pwm-rst;
	status = "disabled";
};

/* pin conflict with PDM */
&flexcan1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan1>;
	xceiver-supply = <&reg_can1_stby>;
	status = "okay";
};

&flexcan2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan2>;
	xceiver-supply = <&reg_can2_stby>;
	status = "okay";
};

&flexcan3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan3>;
	xceiver-supply = <&reg_can3_stby>;
	status = "okay";
};

&flexcan5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan5>;
	xceiver-supply = <&reg_can5_stby>;
	status = "disabled";
};

&flexspi1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_flexspi1>;
	pinctrl-1 = <&pinctrl_flexspi1>;
	status = "disabled";

	/* TODO co-existence with M7/M33 if even possible */

	/* TODO: switch to use reset-gpios */
	//reset-gpios = <&gpio5 11 GPIO_ACTIVE_LOW>;

	pinctrl-assert-gpios = <&gpio5 11 GPIO_ACTIVE_HIGH>;

	mt35xu01gbba: flash@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		spi-max-frequency = <200000000>;
		spi-tx-bus-width = <8>;
		spi-rx-bus-width = <8>;
	};
};

&lpi2c2 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c2>;
	pinctrl-1 = <&pinctrl_lpi2c2>;
	/delete-property/ dmas;
	/delete-property/ dma-names;
	status = "okay";

	i2c2_ioexp21: i2c2-gpio@21 {
		compatible = "nxp,pcal6524";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_i2c2_ioexp21>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio3>;
		interrupts = <26 IRQ_TYPE_EDGE_FALLING>;
		status = "okay";

		sja1110_sw_int_n: sja1110-sw-int-n {
			gpio-hog;
			gpios = <3 (GPIO_ACTIVE_LOW | GPIO_LINE_OPEN_DRAIN | GPIO_PULL_UP)>;
			input;
		};

		usb1_ptn_int_b: usb1-ptn-int-b {
			gpio-hog;
			gpios = <7 (GPIO_ACTIVE_LOW | GPIO_LINE_OPEN_DRAIN | GPIO_PULL_UP)>;
			input;
		};

		usb1_ptn_flt_b: usb1-ptn-flt-b {
			gpio-hog;
			gpios = <8 (GPIO_ACTIVE_LOW | GPIO_LINE_OPEN_DRAIN | GPIO_PULL_UP)>;
			input;
		};

		int_sw_usb1_b: int-sw-usb1-b {
			gpio-hog;
			gpios = <9 (GPIO_ACTIVE_LOW | GPIO_LINE_OPEN_DRAIN)>;
			input;
		};

		usb2_ptn_int_b: usb2-ptn-int-b {
			gpio-hog;
			gpios = <10 (GPIO_ACTIVE_LOW | GPIO_LINE_OPEN_DRAIN | GPIO_PULL_UP)>;
			input;
		};

		usb2_ptn_flt_b: usb2-ptn-flt-b {
			gpio-hog;
			gpios = <11 (GPIO_ACTIVE_LOW | GPIO_LINE_OPEN_DRAIN | GPIO_PULL_UP)>;
			input;
		};

		int_sw_usb2_b: int-sw-usb2-b {
			gpio-hog;
			gpios = <12 (GPIO_ACTIVE_LOW | GPIO_LINE_OPEN_DRAIN)>;
			input;
		};

		eth_clk_en: eth-clk-en {
			gpio-hog;
			gpios = <17 GPIO_ACTIVE_HIGH>;
			output-high;
		};

		si5332_rst: si5332-rst {
			gpio-hog;
			gpios = <18 GPIO_ACTIVE_HIGH>;
			output-low;
		};

		sja1110_rst_n: sja1110-rst-n {
			gpio-hog;
			gpios = <20 GPIO_ACTIVE_LOW>;
			output-low;
		};

		sja1110_rst_core_n: sja1110-rst-core-n {
			gpio-hog;
			gpios = <21 GPIO_ACTIVE_LOW>;
			output-low;
		};

		se_enable: se-enable {
			gpio-hog;
			gpios = <23 GPIO_ACTIVE_HIGH>;
			output-high;
		};
	};

	ptn5110_usb2: tcpc_usb2@52 {
		compatible = "nxp,ptn5110";
		pinctrl-names = "default";
		reg = <0x52>;
		interrupt-parent = <&i2c2_ioexp21>;
		interrupts = <10 IRQ_TYPE_EDGE_FALLING>; // 10 = USB2_PTN_INT_B

		typec_con2: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "source";
			data-role = "dual";
			try-power-role = "source";
			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
			op-sink-microwatt = <0>;
			self-powered;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@1 {
					reg = <1>;
					typec_con_ss2: endpoint {
						remote-endpoint = <&usb2_data_ss>;
					};
				};
			};
		};
	};

	ptn5110_usb3: tcpc_usb3@51 {
		compatible = "nxp,ptn5110";
		pinctrl-names = "default";
		reg = <0x51>;
		interrupt-parent = <&i2c2_ioexp21>;
		interrupts = <7 IRQ_TYPE_EDGE_FALLING>; // 7 = USB1_PTN_INT_B

		port {
			typec_dr_sw3: endpoint {
				remote-endpoint = <&usb3_drd_sw>;
			};
		};

		typec_con3: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			power-role = "source";
			data-role = "dual";
			try-power-role = "source";
			source-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;
			op-sink-microwatt = <0>;
			self-powered;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@1 {
					reg = <1>;
					typec_con_ss3: endpoint {
						remote-endpoint = <&usb3_data_ss>;
					};
				};
			};
		};
	};
};

&lpi2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c3>;
	pinctrl-1 = <&pinctrl_lpi2c3>;
	status = "okay";

	i2c3_ioexp22: i2c3-gpio@22 {
		compatible = "nxp,pcal6524";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
/*
interrupt connected to pcal6416 managed by m33
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_i2c3_ioexp22>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio3>;
		interrupts = <26 IRQ_TYPE_LEVEL_LOW>;
*/
		status = "okay";

		can_power_en: can-power-en {
			gpio-hog;
			gpios = <0 GPIO_ACTIVE_HIGH>;
			output-high;
		};

		/* enable can5; used by m7 */

		can5_en: can5-en {
			gpio-hog;
			gpios = <10 GPIO_ACTIVE_HIGH>;
			output-high;
		};

		can5_stby_b: can5-stby-b {
			gpio-hog;
			gpios = <11 GPIO_ACTIVE_LOW>;
			output-low;
		};

		m2_pwren_ssd_n: m2-pwren-ssd-n {
			gpio-hog;
			gpios = <13 GPIO_ACTIVE_LOW>;
			output-high;
		};

		m2_pwren_5g_n: m2-pwren-5g-n {
			gpio-hog;
			gpios = <14 GPIO_ACTIVE_LOW>;
			output-high;
		};

		pcie1_full_card_power_off_n: full-card-power-off-n {
			gpio-hog;
			gpios = <15 GPIO_ACTIVE_LOW>;
			output-low;
		};

		usb1_wat_flg_b: usb1-wat-flg-b {
			gpio-hog;
			gpios = <16 (GPIO_ACTIVE_LOW | GPIO_LINE_OPEN_DRAIN | GPIO_PULL_UP)>;
			input;
		};

		usb2_wat_flg_b: usb2-wat-flg-b {
			gpio-hog;
			gpios = <17 (GPIO_ACTIVE_LOW | GPIO_LINE_OPEN_DRAIN | GPIO_PULL_UP)>;
			input;
		};

		enable_1v8_buffer_b: enable-1v8-buffer-b {
			gpio-hog;
			gpios = <23 GPIO_ACTIVE_LOW>;
			output-high;
		};
	};

	i2c3_ioexp23: i2c3-gpio@23 {
		compatible = "nxp,pcal6524";
		reg = <0x23>;
		gpio-controller;
		#gpio-cells = <2>;
/*
interrupt connected to pcal6416 managed by m33
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_i2c3_ioexp23>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio3>;
		interrupts = <26 IRQ_TYPE_LEVEL_LOW>;
*/
		status = "okay";

		// pcie1_w_disable_n: w-disable-n {
		// 	gpio-hog;
		// 	gpios = <9 GPIO_ACTIVE_LOW>;
		// 	output-low;
		// };

		// pcie1_pewake_n: pewake-n {
		// 	gpio-hog;
		// 	gpios = <4 GPIO_ACTIVE_LOW>;
		// 	output-low;
		// };

		// pcie1_reset_n: reset-n {
		// 	gpio-hog;
		// 	gpios = <23 GPIO_ACTIVE_LOW>;
		// 	output-low;
		// };
	};
};

&lpi2c4 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c4>;
	pinctrl-1 = <&pinctrl_lpi2c4>;
	status = "okay";
};

&lpuart1 {
	/* console */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	/delete-property/ dmas;
	/delete-property/ dma-names;
	status = "okay";
};

&lpuart6 {
	/* BT */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart6>;
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		compatible = "nxp,88w8987-bt";
	};
};

&lpspi7 {
	fsl,spi-num-chipselects = <1>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpspi7>;
	pinctrl-1 = <&pinctrl_lpspi7>;
	cs-gpios = <&gpio2 4 GPIO_ACTIVE_LOW>;
	status = "disabled";

	spidev0: spi@0 {
		reg = <0>;
		compatible = "lwn,bk4";
		spi-max-frequency = <1000000>;
	};
};

&mu7 {
	status = "okay";
};

&usdhc1 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc1>;
	pinctrl-1 = <&pinctrl_usdhc1_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc1_200mhz>;
	pinctrl-3 = <&pinctrl_usdhc1>;
	bus-width = <8>;
	non-removable;
	no-sdio;
	no-sd;
	status = "okay";
};

&usdhc2 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-3 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	cd-gpios = <&gpio3 00 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&reg_usdhc2_vmmc>;
	bus-width = <4>;
	status = "okay";
};

&usdhc3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc3>;
	vmmc-supply = <&reg_usdhc3_vmmc>;
	mmc-pwrseq = <&usdhc3_pwrseq>;
	bus-width = <4>;
	keep-power-in-suspend;
	non-removable;
	status = "okay";
};

&enetc_port0 {
	//serdes-supply = <&reg_serdes_en>; // This will make the end0 interface sometimes not getting an ip4 address. Timing?
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enetc0>;
	phy-handle = <&ethphy0>;
	phy-mode = "rgmii-id";
	status = "okay";
};

&enetc_port1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enetc1>;
	phy-mode = "rgmii-id";
	status = "okay";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

// &enetc_port2 {
// 	//phy-handle = <&ethphy2>;
// 	//pinctrl-0 = <&pinctrl_enetc2>;
// 	//phy-mode = "sgmii-2500";
// 	//phy-mode = "2500base-x";
// 	phy-mode = "sgmii";
// 	//serdes-supply = <&reg_serdes_en>;
// 	//managed = "in-band-status";
// 	status = "okay";

//  	fixed-link {
// 		speed = <2500>;
// 		full-duplex;
// 	};
// };

&netc_timer {
	status = "okay";
};

&netc_prb_ierb {
	netc-interfaces = <NXP_NETC_RGMII
			   NXP_NETC_RGMII
			   NXP_NETC_SERIAL>;
};

&netc_emdio {
	status = "okay";
	ethphy0: ethernet-phy@1 {
		reg = <1>;
		eee-broken-1000t;
		reset-gpios = <&i2c2_ioexp21 16 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <80000>;
		realtek,clkout-disable;
	};
};

&usb2 {
	dr_mode = "host";
	disable-over-current;
	status = "okay";

	port {
		usb2_data_ss: endpoint {
			remote-endpoint = <&typec_con_ss2>;
		};
	};

};

&usb3 {
	status = "okay";
};

&usb3_phy {
	status = "okay";
	port {
		usb3_data_ss: endpoint {
			remote-endpoint = <&typec_con_ss3>;
		};
	};
};

&usb3_dwc3 {
	dr_mode = "otg";
	hnp-disable;
	srp-disable;
	adp-disable;
	usb-role-switch;
	role-switch-default-mode = "none";
	snps,dis-u1-entry-quirk;
	snps,dis-u2-entry-quirk;

	port {
		usb3_drd_sw: endpoint {
			remote-endpoint = <&typec_dr_sw3>;
		};
	};
};

&thermal_zones {
	a55 {
		trips {
			atrip2: trip2 {
				temperature = <55000>;
				hysteresis = <2000>;
				type = "active";
			};

			atrip3: trip3 {
				temperature = <65000>;
				hysteresis = <2000>;
				type = "active";
			};

			atrip4: trip4 {
				temperature = <75000>;
				hysteresis = <2000>;
				type = "active";
			};
		};

		cooling-maps {
			map1 {
				trip = <&atrip2>;
				cooling-device = <&fan0 0 1>;
			};

			map2 {
				trip = <&atrip3>;
				cooling-device = <&fan0 1 2>;
			};

			map3 {
				trip = <&atrip4>;
				cooling-device = <&fan0 2 3>;
			};
		};
	};

	pf09 {
		polling-delay-passive = <250>;
		polling-delay = <2000>;
		thermal-sensors = <&scmi_sensor 2>;
		trips {
			pf09_alert: trip0 {
				temperature = <140000>;
				hysteresis = <2000>;
				type = "passive";
			};

			pf09_crit: trip1 {
				temperature = <155000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};

	pf53_arm {
		polling-delay-passive = <250>;
		polling-delay = <2000>;
		thermal-sensors = <&scmi_sensor 4>;
		trips {
			pf5301_alert: trip0 {
				temperature = <140000>;
				hysteresis = <2000>;
				type = "passive";
			};

			pf5301_crit: trip1 {
				temperature = <155000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};

		cooling-maps {
			map0 {
				trip = <&pf5301_alert>;
				cooling-device =
					<&A55_0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&A55_1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&A55_2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&A55_3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&A55_4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&A55_5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	pf53_soc {
		polling-delay-passive = <250>;
		polling-delay = <2000>;
		thermal-sensors = <&scmi_sensor 3>;
		trips {
			pf5302_alert: trip0 {
				temperature = <140000>;
				hysteresis = <2000>;
				type = "passive";
			};

			pf5302_crit: trip1 {
				temperature = <155000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};
	};
};

&scmi_misc {
	wakeup-sources = <BRD_SM_CTRL_SD3_WAKE		1
			  BRD_SM_CTRL_PCIE1_WAKE	1
			  BRD_SM_CTRL_BT_WAKE		1
			  BRD_SM_CTRL_PCIE2_WAKE	1
			  BRD_SM_CTRL_BUTTON		1>;
};

