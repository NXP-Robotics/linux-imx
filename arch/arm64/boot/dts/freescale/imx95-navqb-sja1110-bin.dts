#include "imx95-navqb.dts"

/delete-node/ &sja1110_ap;

&lpspi4 {
        sja1110_sw: sja1110-switch@1 {
		compatible = "nxp,sja1110-switch";
		reg = <1>;
		spi-max-frequency = <5000000>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	sja1110_uc: sja1110-uc@2 {
		compatible = "nxp,sja1110-uc";
		reg = <2>;
		spi-max-frequency = <5000000>;
	};
};