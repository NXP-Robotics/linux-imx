#include "imx95-navqa.dts"

&lpuart5 {
	status = "disabled";
};

&lpspi3 {
	fsl,spi-num-chipselects = <2>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpspi3>;
	pinctrl-1 = <&pinctrl_lpspi3>;
	cs-gpios = <&gpio2 8 GPIO_ACTIVE_LOW>, <&gpio2 20 GPIO_ACTIVE_LOW>;
	dmas = <>;
	dma-names = "";

	status = "okay";

	spidev0_0@0 {
		compatible = "spidev";
		reg = <0>; // Chip select 0
		spi-max-frequency = <20000000>; // 20 MHz
	};

	spidev0_1@1 {
		compatible = "spidev";
		reg = <1>; // Chip select 1
		spi-max-frequency = <20000000>; // 20 MHz
	};
};

&lpspi6 {
	fsl,spi-num-chipselects = <2>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpspi6>;
	pinctrl-1 = <&pinctrl_lpspi6>;
	cs-gpios = <&gpio2 0 GPIO_ACTIVE_LOW>, <&gpio2 21 GPIO_ACTIVE_LOW>;
	dmas = <>;
	dma-names = "";

	status = "okay";

	spidev1_0@0 {
		compatible = "spidev";
		reg = <0>; // Chip select 0
		spi-max-frequency = <20000000>; // 20 MHz
	};

	spidev1_1@1 {
		compatible = "spidev";
		reg = <1>; // Chip select 1
		spi-max-frequency = <20000000>; // 20 MHz
	};
};

/*
 * The second PCS's of both SPI busses are set to GPIO by default.
 * Linux has no access rights to these PINS so it will not touch them.
 * Make sure no M7 software is running because it can change the mux setting.
 * (IMX95_PAD_GPIO_IO21__GPIO2_IO_BIT20 and IMX95_PAD_GPIO_IO20__GPIO2_IO_BIT21)
 */

&scmi_iomuxc {
        pinctrl_lpspi6: lpspi6grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO00__GPIO2_IO_BIT0	0x31e
			IMX95_PAD_GPIO_IO01__LPSPI6_SIN 	0x31e
			IMX95_PAD_GPIO_IO02__LPSPI6_SOUT        0x31e
			IMX95_PAD_GPIO_IO03__LPSPI6_SCK 	0x31e
		>;
	};

	pinctrl_lpspi3: lpspi3grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO08__GPIO2_IO_BIT8	0x31e
			IMX95_PAD_GPIO_IO09__LPSPI3_SIN 	0x31e
			IMX95_PAD_GPIO_IO10__LPSPI3_SOUT        0x31e
			IMX95_PAD_GPIO_IO11__LPSPI3_SCK 	0x31e
		>;
	};
};

&gpio2 {
	status = "okay";
};

&lpi2c3 {
	/delete-node/ ov5640@3c;
};

&lpi2c4 {
	/delete-node/ ov5640@3c;
};

/ {
	dummy_csi0: dummy_csi0 {
		compatible = "raspberrypi,dummy-csi2-sensor";
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
			};

			port@1 {
				reg = <1>;
			};

			port@2 {
				reg = <2>;
				dummy_csi0_out: endpoint {
					remote-endpoint = <&mipi_csi0_ep>;
					data-lanes = <1>;
					clock-lanes = <0>;
					clock-noncontinuous;
				};
			};
		};
	};
};

/* Override to use dummy csi device and single lane */

&mipi_csi0_ep {
	remote-endpoint = <&dummy_csi0_out>;
	data-lanes = <1>;
	clock-lanes = <0>;
	clock-noncontinuous;
};

/* Disable CSI1 port formatter & ISI */

&mipi_csi1 {
	status = "disabled";
    /delete-node/ ports;
};

&csi_pixel_formatter_1 {
	status = "disabled";
    /delete-node/ ports;
};

&isi {
	ports {
		/delete-node/ port@3;
	};
};
