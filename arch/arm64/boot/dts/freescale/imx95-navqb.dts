/dts-v1/;

#include "imx95-navq.dtsi"
/ {
	model = "NXP X-MR-NAVQ95B";
	compatible = "fsl,imx95-navqb", "fsl,imx95";

	reg_can1_stby: regulator-can1-stby {
		compatible = "regulator-fixed";
		regulator-name = "can1-stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c4_ioexp20 1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&reg_can1_en>;
	};

	reg_can1_en: regulator-can1-en {
		compatible = "regulator-fixed";
		regulator-name = "can1-en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c4_ioexp20 0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_can2_stby: regulator-can2-stby {
		compatible = "regulator-fixed";
		regulator-name = "can2-stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c4_ioexp20 3 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&reg_can2_en>;
	};

	reg_can2_en: regulator-can2-en {
		compatible = "regulator-fixed";
		regulator-name = "can2-en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c4_ioexp20 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_can3_stby: regulator-can3-stby {
		compatible = "regulator-fixed";
		regulator-name = "can3-stby";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c4_ioexp20 5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&reg_can3_en>;
	};

	reg_can3_en: regulator-can3-en {
		compatible = "regulator-fixed";
		regulator-name = "can3-en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&i2c4_ioexp20 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

&lpi2c3 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c3>;
	pinctrl-1 = <&pinctrl_lpi2c3>;
	status = "okay";

	i2c3_ioexp21: i2c3-gpio@21 {
		compatible = "nxp,pcal6524";
		reg = <0x21>;
		gpio-controller;
		#gpio-cells = <2>;
/*
interrupt connected to pcal6416 managed by m33
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_i2c3_ioexp22>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio3>;
		interrupts = <26 IRQ_TYPE_LEVEL_LOW>;
*/
		status = "okay";

		
	};
};

&lpi2c4 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c4>;
	pinctrl-1 = <&pinctrl_lpi2c4>;
	status = "okay";

	i2c4_ioexp20: i2c4-gpio@20 {
		compatible = "nxp,pcal6524";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
/*
interrupt connected to pcal6416 managed by m33
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_i2c3_ioexp22>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio3>;
		interrupts = <26 IRQ_TYPE_LEVEL_LOW>;
*/
		status = "okay";

		can_power_en: can-power-en {
			gpio-hog;
			gpios = <7 GPIO_ACTIVE_HIGH>;
			output-high;
		};

		led_r: led-r {
			gpio-hog;
			gpios = <11 GPIO_ACTIVE_HIGH>;
			output-low;
		};

		led_g: led-g {
			gpio-hog;
			gpios = <12 GPIO_ACTIVE_HIGH>;
			output-high;
		};

		led_b: led-b {
			gpio-hog;
			gpios = <13 GPIO_ACTIVE_HIGH>;
			output-high;
		};

		sw_led_out: sw-led-out {
			gpio-hog;
			gpios = <15 GPIO_ACTIVE_HIGH>;
			output-high;
		};
	};
};

&lpuart7 {
	/* Lidar */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart7>;
	uart-has-rtscts;
	status = "okay";
};

&lpuart4 {
	/* BT */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart4>;
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		compatible = "nxp,88w8987-bt";
	};
};

&lpspi4 {
	fsl,spi-num-chipselects = <1>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpspi4>;
	pinctrl-1 = <&pinctrl_lpspi4>;
	// cs-gpios = <&gpio5 14 GPIO_ACTIVE_LOW>,
	// 	   <&gpio5 13 GPIO_ACTIVE_LOW>,
	// 	   <&gpio2 16 GPIO_ACTIVE_LOW>; Can't use this because GPIO2 is being used by M7
	num-cs = <3>;
	status = "okay";

	spidev0: spi@0 { //TODO triradio
		reg = <0>;
		compatible = "lwn,bk4";
		spi-max-frequency = <1000000>;
	};

	spidev1: spi@1 { //TODO SJA1110
		reg = <1>;
		compatible = "lwn,bk4";
		spi-max-frequency = <1000000>;
	};

	spidev2: spi@2 { //TODO SJA1110
		reg = <2>;
		compatible = "lwn,bk4";
		spi-max-frequency = <1000000>;
	};
};

&flexcan1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan1>;
	xceiver-supply = <&reg_can1_stby>;
	status = "okay";
};

&flexcan2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan2>;
	xceiver-supply = <&reg_can2_stby>;
	status = "okay";
};

&flexcan3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexcan3>;
	xceiver-supply = <&reg_can3_stby>;
	status = "okay";
};

&netc_emdio {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_emdio>;
	status = "okay";

	ethphy0: ethernet-phy@1 {
		reg = <1>;
		eee-broken-1000t;
		reset-gpios = <&i2c3_ioexp21 1 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <80000>;
		realtek,clkout-disable;
	};
};

&enetc_port0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enetc0>;
	phy-handle = <&ethphy0>;
	phy-mode = "rgmii-id";
	status = "okay";
};

&scmi_iomuxc {
	pinctrl_uart4: uart4grp {
		fsl,pins = <
			IMX95_PAD_ENET2_TD0__LPUART4_TX			0x31e
			IMX95_PAD_ENET2_RD0__LPUART4_RX			0x31e
			IMX95_PAD_ENET2_TD1__LPUART4_RTS_B		0x31e
			IMX95_PAD_ENET2_RD2__LPUART4_CTS_B		0x31e

		>;
	};

	pinctrl_uart7: uart7grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO08__LPUART7_TX			0x31e
			IMX95_PAD_GPIO_IO09__LPUART7_RX			0x31e
			IMX95_PAD_GPIO_IO11__LPUART7_RTS_B		0x31e
			IMX95_PAD_GPIO_IO10__LPUART7_CTS_B		0x31e
		>;
	};

	pinctrl_lpspi4: lpspi4grp {
		fsl,pins = <
			IMX95_PAD_GPIO_IO34__GPIO5_IO_BIT14	0x3fe
			IMX95_PAD_GPIO_IO33__GPIO5_IO_BIT13	0x3fe
			IMX95_PAD_GPIO_IO16__GPIO2_IO_BIT16	0x3fe
			IMX95_PAD_GPIO_IO19__LPSPI4_SIN		0x3fe
			IMX95_PAD_GPIO_IO36__LPSPI4_SOUT	0x3fe
			IMX95_PAD_GPIO_IO37__LPSPI4_SCK		0x3fe
		>;
	};
};
